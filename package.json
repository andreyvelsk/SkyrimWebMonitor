{
  "name": "skyrimwebmonitor",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A Vue 3 PWA companion app for The Elder Scrolls V: Skyrim. Monitors player stats, inventory, magic and hotkeys in real time over WebSocket. Designed primarily for the AYN Thor handheld.",
  "keywords": [
    "skyrim",
    "the-elder-scrolls",
    "pwa",
    "vue",
    "vue3",
    "vite",
    "websocket",
    "companion-app",
    "ayn-thor",
    "skse"
  ],
  "homepage": "https://andreyvelsk.github.io/SkyrimWebMonitor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreyvelsk/SkyrimWebMonitor.git"
  },
  "bugs": {
    "url": "https://github.com/andreyvelsk/SkyrimWebMonitor/issues"
  },
  "author": "Andrey Velsk (https://github.com/andreyvelsk)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "BASE_PATH=./ VITE_CAPACITOR=true vite build",
    "preview": "vite preview",
    "tsc": "vue-tsc --noEmit",
    "release": "node ./scripts/release.js",
    "release:patch": "node ./scripts/release.js patch",
    "release:minor": "node ./scripts/release.js minor",
    "release:major": "node ./scripts/release.js major",
    "cap:sync:android": "npm run build:android && npx cap sync android",
    "android:apk": "npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "android:open": "npm run cap:sync:android && npx cap open android",
    "export-fixtures": "node scripts/export-fixtures.js",
    "build:electron": "BASE_PATH=./ vite build",
    "electron:preview": "npm run build:electron && electron .",
    "electron:dist:linux-x64": "npm run build:electron && electron-builder --linux AppImage --x64",
    "electron:dist:linux-arm64": "npm run build:electron && electron-builder --linux AppImage --arm64",
    "electron:dist:mac": "npm run build:electron && electron-builder --mac dmg",
    "electron:dist": "npm run build:electron && electron-builder --linux AppImage --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai": "node scripts/test-ai.mjs",
    "lint": "vue-tsc --noEmit && eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{vue,css,scss}\" --fix",
    "format": "prettier --write \"src/**/*.{vue,js,jsx,json,css,scss}\" && npm run lint:css"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.3",
    "idb": "^7.1.1",
    "openseadragon": "^6.0.2",
    "opentype.js": "^2.0.0",
    "pinia": "^3.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "workbox-window": "^7.4.1"
  },
  "browserslist": [
    "Chrome >= 90",
    "Android >= 8",
    "and_chr >= 90",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "devDependencies": {
    "@capacitor/cli": "^7.6.3",
    "@eslint/js": "^9.39.5",
    "@types/openseadragon": "^5.0.2",
    "@types/opentype.js": "^1.3.10",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "stylelint": "^17.6.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.9",
    "ws": "^8.13.0"
  },
  "build": {
    "appId": "com.andreyvelsk.skyrimwebmonitor",
    "productName": "SkyrimWebMonitor",
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
